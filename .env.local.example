# ============================================================
# REQUIRED — the app won't start (or won't work) without these.
# ============================================================

# Plain PostgreSQL connection string (see docker-compose.yml for a local one).
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/whatsapp_gateway

# Token encryption (64 hex chars = 32 bytes, AES-256-GCM). Encrypts every
# tenant's WABA access token and webhook signing secret at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — every connected account would need to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
#   - Verifies the HMAC-SHA256 signature on every inbound webhook POST.
#   - Used server-side to exchange an Embedded Signup `code` for a token.
# Required — without it, inbound webhooks are rejected and the connect
# flow can't exchange a signup code.
META_APP_SECRET=your-meta-app-secret

# Meta App ID (Meta for Developers → App Settings → Basic). Needed for:
#   - the Embedded Signup code exchange (paired with META_APP_SECRET)
#   - the frontend's Meta JS SDK init (not secret — safe to expose client-side)
META_APP_ID=your-meta-app-id

# Meta Embedded Signup configuration id (Meta App Dashboard → WhatsApp →
# Embedded Signup → your configuration). Not secret. The frontend passes
# this to FB.login({config_id: ...}) to launch the signup popup.
META_CONFIG_ID=your-embedded-signup-config-id

# The verify token you set in Meta App Dashboard → WhatsApp → Configuration
# → Webhooks, for the GET verification handshake (hub.challenge).
META_WEBHOOK_VERIFY_TOKEN=choose-any-long-random-string

# This service's own public URL. Used to build the sample document link
# submitted with the auto-created "invoice_ready" template.
GATEWAY_PUBLIC_BASE_URL=http://localhost:3100

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# When "true", POST /api/whatsapp/templates/submit (and the
# auto-created invoice template) skip the Meta call and store a
# synthetic `dry-run-<uuid>` meta_template_id. Useful for local dev /
# CI without a real Meta App. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true
