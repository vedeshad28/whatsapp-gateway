// Prisma schema for the WhatsApp Gateway — replaces wacrm's Supabase/Postgres
// schema. Dropped entirely: the human-user model (auth.users, profiles, RLS),
// tags/custom-fields/notes/pipelines/notifications/AI-autoreply state — none
// of it applies to a headless, API-key-authenticated gateway.
//
// New concept not present in wacrm: `Client` — the calling application
// (e.g. salon-saas). One Client can own many `Account`s (one per WABA it
// connects, e.g. one per salon tenant), all under a single Client-level
// API key. wacrm assumed one key per single self-serve account; here a
// key belongs to a Client and can act on any Account that Client owns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  apiKeys   ApiKey[]
  accounts  Account[]

  @@map("clients")
}

model ApiKey {
  id         String    @id @default(uuid())
  clientId   String    @map("client_id")
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([clientId])
  @@map("api_keys")
}

/// One connected WABA. `externalRef` is an opaque id the calling app
/// supplies (e.g. its own tenant UUID) so it can find "its" account
/// again without the gateway knowing anything about salons/tenants.
model Account {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  externalRef String?  @map("external_ref")
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  whatsappConfig     WhatsappConfig?
  messageTemplates   MessageTemplate[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  webhookEndpoints   WebhookEndpoint[]
  wallet             AccountWallet?
  walletTransactions WalletTransaction[]

  @@unique([clientId, externalRef])
  @@map("accounts")
}

model WhatsappConfig {
  id                    String    @id @default(uuid())
  accountId             String    @unique @map("account_id")
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  phoneNumberId         String    @map("phone_number_id")
  wabaId                String?   @map("waba_id")
  businessAccountId     String?   @map("business_account_id")
  displayPhoneNumber    String?   @map("display_phone_number")
  verifiedName          String?   @map("verified_name")
  /// AES-256-GCM encrypted (see src/lib/whatsapp/encryption.ts).
  accessToken           String    @map("access_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  status                String    @default("connected")
  connectedAt           DateTime? @map("connected_at")
  /// Set when POST /{phone_number_id}/register last succeeded.
  registeredAt          DateTime? @map("registered_at")
  /// Set when POST /{waba_id}/subscribed_apps last succeeded.
  subscribedAppsAt      DateTime? @map("subscribed_apps_at")
  lastRegistrationError String?   @map("last_registration_error")

  @@map("whatsapp_config")
}

model MessageTemplate {
  id              String    @id @default(uuid())
  accountId       String    @map("account_id")
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  category        String
  language        String?
  headerType      String?   @map("header_type")
  headerContent   String?   @map("header_content")
  headerHandle    String?   @map("header_handle")
  headerMediaUrl  String?   @map("header_media_url")
  bodyText        String    @map("body_text")
  footerText      String?   @map("footer_text")
  buttons         Json?
  sampleValues    Json?     @map("sample_values")
  status          String?
  metaTemplateId  String?   @map("meta_template_id")
  rejectionReason String?   @map("rejection_reason")
  qualityScore    String?   @map("quality_score")
  submissionError String?   @map("submission_error")
  lastSubmittedAt DateTime? @map("last_submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([accountId, name, language])
  @@map("message_templates")
}

model Contact {
  id            String         @id @default(uuid())
  accountId     String         @map("account_id")
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  conversations Conversation[]

  @@unique([accountId, phone])
  @@map("contacts")
}

model Conversation {
  id              String    @id @default(uuid())
  accountId       String    @map("account_id")
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId       String    @map("contact_id")
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lastMessageText String?   @map("last_message_text")
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  messages        Message[]

  @@unique([accountId, contactId])
  @@map("conversations")
}

model Message {
  id                 String       @id @default(uuid())
  accountId          String       @map("account_id")
  account            Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversationId     String       @map("conversation_id")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType         String       @map("sender_type")
  contentType        String       @map("content_type")
  contentText        String?      @map("content_text")
  mediaUrl           String?      @map("media_url")
  templateName       String?      @map("template_name")
  /// Meta's wamid — used to correlate inbound status-update webhooks.
  messageId          String?      @map("message_id")
  status             String       @default("sending")
  replyToMessageId   String?      @map("reply_to_message_id")
  interactivePayload Json?        @map("interactive_payload")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([accountId])
  @@index([messageId])
  @@map("messages")
}

model AccountWallet {
  id        String   @id @default(uuid())
  accountId String   @unique @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account_wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String   // CREDIT or DEBIT
  amount      Int
  balance     Int      // balance after this transaction
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([accountId, createdAt])
  @@map("wallet_transactions")
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  accountId      String    @map("account_id")
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url            String
  /// AES-256-GCM encrypted HMAC signing secret.
  secret         String
  events         String[]
  isActive       Boolean   @default(true) @map("is_active")
  lastDeliveryAt DateTime? @map("last_delivery_at")
  failureCount   Int       @default(0) @map("failure_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("webhook_endpoints")
}
